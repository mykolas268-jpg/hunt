# Postgres. Railway injects this automatically in production.
DATABASE_URL="postgresql://user:pass@localhost:5432/hunt_dev?schema=public"

# Shopify app credentials (from the Partner Dashboard).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://your-app.up.railway.app"
SCOPES="write_products,read_locations,write_inventory"

# Anthropic API key for listing generation.
ANTHROPIC_API_KEY=""

# 32-byte base64 key for AES-256-GCM encryption of supplier credentials.
# Generate with: openssl rand -base64 32
# Rotating this makes every stored supplier credential undecryptable.
ENCRYPTION_KEY=""
